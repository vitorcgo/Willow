{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Willow",
  "version": "0.1.10",
  "identifier": "com.willow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Willow",
        "width": 1920,
        "height": 420,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "Configurações do Willow",
        "url": "settings.html",
        "width": 620,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "focus": true,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "ai-usage",
        "title": "Uso de IA do Willow",
        "url": "ai-usage.html",
        "width": 360,
        "height": 624,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Painel do Willow",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "dock",
        "title": "Willow Dock",
        "url": "dock.html",
        "width": 1920,
        "height": 600,
        "x": 0,
        "y": 480,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://ipapi.co https://ip-api.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {}
}
